# Claude API key (server only — never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: one-click demo login (create the account with supabase/demo.sql). Server only.
DEMO_EMAIL=demo@cuecard.app
DEMO_PASSWORD=

# Copilot meeting-audio transcription (server only). Set ONE of these.
# Claude doesn't accept audio, so speech-to-text uses a dedicated service.
# Microphone mode works without either (browser speech recognition).
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
